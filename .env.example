# cryptospider 环境变量示例：复制为 .env 后按需填写（.env 已被 .gitignore 忽略）
# 只需要填写你实际要运行的爬虫/机器人用到的变量。

# 运行环境：local / test / pre / prod
env=local

# ===== 基础设施：Redis / MySQL / 代理 =====
CF_RPC=localhost
# 用于: brc20, dexfilter
CF_RPC_HOST=
# 用于: utils
KAFKA_BOOTSTRAP_SERVERS=
# 用于: brc20, coingecko_once, config, scrapy_spider
PROXY_URL=
RDS_HOST=127.0.0.1
RDS_PORT=3306
# 用于: config
RDS_PASSWORD=
RDS_USER=root
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 用于: config
REDIS_PASSWORD=
# 用于: config
REDIS_USERNAME=

# ===== 阿里云 SLS / RocketMQ =====
# 用于: config
ALIYUN_ACCESS_KEY_ID=
# 用于: config
ALIYUN_ACCESS_KEY_SECRET=
# 用于: config
ALIYUN_SLS_ENDPOINT=
# 用于: config
ALIYUN_SLS_LOGSTORE=
# 用于: config
ALIYUN_SLS_PROJECT=

